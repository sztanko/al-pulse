---
import '../styles/tokens.css';
import '../styles/base.css';
import { meta } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'map' | 'areas';
}

const { title, description, active } = Astro.props;
const m = meta();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />

    {/*
      The one place a blocking script earns its keep. Applied any later, the
      wrong palette paints for a frame and then swaps. Nothing is stamped when
      there is no stored preference, so the CSS keeps following the system
      setting with JavaScript disabled.
    */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('al-theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {
          /* private mode: fall through to the system setting */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href={href('/')}>AL&nbsp;Pulse</a>
      <nav>
        <a href={href('/')} aria-current={active === 'home' ? 'page' : undefined}>Overview</a>
        <a href={href('/map')} aria-current={active === 'map' ? 'page' : undefined}>Map</a>
        <a href={href('/areas')} aria-current={active === 'areas' ? 'page' : undefined}>Areas</a>
        <a href={href('/method')}>Method</a>
      </nav>
      <div class="theme-toggle" id="theme-toggle" role="group" aria-label="Colour theme">
        <button type="button" data-theme-choice="light" title="Light">Light</button>
        <button type="button" data-theme-choice="system" title="Follow system">Auto</button>
        <button type="button" data-theme-choice="dark" title="Dark">Dark</button>
      </div>
    </header>

    <main id="main" class="shell">
      <slot />

      <footer class="footer">
        <p>
          Data through <strong>{m.data_through}</strong> from the Registo Nacional
          de Turismo, and for the Azores from the Região Autónoma dos Açores'
          own register. {m.counts.localities.toLocaleString('en-GB')} localities,
          {' '}{m.counts.municipalities} municipalities,
          {' '}{m.counts.regions} districts and autonomous regions.
          The Azorean register records no dates, so those
          {' '}{m.azores.areas} areas are counted but never charted.
          <a href={href('/method')}>How this is built, and what it cannot tell you</a>.
        </p>
      </footer>
    </main>

    {/* Three states, because "follow my system" is a real preference and a
        two-way toggle cannot return to it. */}
    <script is:inline>
      (function () {
        var box = document.getElementById('theme-toggle');
        if (!box) return;
        var KEY = 'al-theme';
        function current() {
          try {
            var v = localStorage.getItem(KEY);
            return v === 'light' || v === 'dark' ? v : 'system';
          } catch (e) {
            return 'system';
          }
        }
        function paint() {
          var c = current();
          box.querySelectorAll('button').forEach(function (b) {
            b.setAttribute(
              'aria-pressed',
              b.getAttribute('data-theme-choice') === c ? 'true' : 'false'
            );
          });
        }
        box.addEventListener('click', function (e) {
          var b = e.target && e.target.closest ? e.target.closest('button') : null;
          if (!b) return;
          var choice = b.getAttribute('data-theme-choice');
          try {
            if (choice === 'system') {
              localStorage.removeItem(KEY);
              document.documentElement.removeAttribute('data-theme');
            } else {
              localStorage.setItem(KEY, choice);
              document.documentElement.setAttribute('data-theme', choice);
            }
          } catch (err) {
            /* storage unavailable — still apply for this page view */
            if (choice === 'system') document.documentElement.removeAttribute('data-theme');
            else document.documentElement.setAttribute('data-theme', choice);
          }
          paint();
        });
        paint();
        box.setAttribute('data-ready', '1');
      })();
    </script>
  </body>
</html>
