---
import Base from '../../layouts/Base.astro';
import Metric from '../../components/Metric.astro';
import RoomMix from '../../components/RoomMix.astro';
import TimeSeries from '../../components/TimeSeries.tsx';
import GrowthExplorer from '../../components/GrowthExplorer.tsx';
import SubareaMix from '../../components/SubareaMix.tsx';
import AreaTable from '../../components/AreaTable.tsx';
import AzoresNote from '../../components/AzoresNote.astro';
import EventKey from '../../components/EventKey.astro';
import Tabs from '../../components/Tabs.astro';
import {
  areas, shard, meta, events, childrenOf, localitiesUnder, lostSummary,
  areaBySlug, observedPeak, lossStartIndex, unobservedIndices, emptySeries,
  type AreaRow,
} from '../../lib/data';
import { num0, pct1, monthLabel } from '../../lib/format';

export function getStaticPaths() {
  return areas().map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const a = areaBySlug(slug!)!;
const d = shard(slug!);
const m = meta();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const months = m.months;
const last = months.length - 1;

const isLocality = a.admin_type === 'locality';
const isRegion = a.admin_type === 'region';

// The Azores have no monthly series at all — their register records no
// registration dates. Everything time-derived below is therefore computed only
// when there is a series to compute it from, and is null otherwise; the page
// renders an explanation where the charts would be rather than charting zeros.
const hasSeries = d.in_time_series && d.series != null;
const S = d.series ?? emptySeries();

const threeBack = Math.max(0, last - 36);
// The count itself survives without a series: it is this month's number, which
// is exactly what a snapshot is.
const total = hasSeries ? (S.cum_c[last] ?? 0) : (a.al_count ?? 0);
const totalThen = S.cum_c[threeBack] ?? 0;
const growth3y = hasSeries && totalThen ? total / totalThen - 1 : null;

const alk = S.al_per_1000[last] ?? 0;
const alkThen = S.al_per_1000[threeBack] ?? 0;
const inhabPerAl = hasSeries ? (alk ? 1000 / alk : null) : (a.inhabitants_per_al ?? null);
const inhabThen = alkThen ? 1000 / alkThen : null;
const inhabChange =
  hasSeries && inhabPerAl && inhabThen ? inhabPerAl / inhabThen - 1 : null;

const rankC = hasSeries ? (S.rank_c[last] ?? null) : null;
const rankCThen = hasSeries ? (S.rank_c[threeBack] ?? null) : null;
const rankR = hasSeries ? (S.rank_r[last] ?? null) : null;
const rankRThen = hasSeries ? (S.rank_r[threeBack] ?? null) : null;
const rankM = hasSeries ? (S.rank_m[last] ?? null) : null;
const rankMThen = hasSeries ? (S.rank_m[threeBack] ?? null) : null;

const lost = lostSummary(S);
const evs2 = events();
// The island only needs a month and a short label; the key needs the prose.
// Both are derived from the same array in the same order, which is what keeps
// mark "3" meaning the same law in the chart and in the key beneath it.
const evs = evs2.map((e) => ({ month: e.month, label: e.event_name }));

// Peer population for the rank context line — a rank only means something
// against the size of the set it ranks within.
const peers = areas().filter((x) => x.admin_type === a.admin_type).length;

const kids: AreaRow[] = childrenOf(a);
const locs: AreaRow[] = isLocality ? [] : localitiesUnder(a);

const toRow = (x: AreaRow) => ({
  slug: x.slug,
  name: x.name,
  al_count: x.al_count,
  inhabitants_per_al: x.inhabitants_per_al,
  al_per_1000: x.al_per_1000,
  rank_within_country: x.rank_within_country,
  al_count_growth_pcnt: x.al_count_growth_pcnt,
  rank_within_country_change: x.rank_within_country_change,
  in_time_series: x.in_time_series,
});

const backHref = d.parent ? `${base}/areas/${d.parent.slug}` : `${base}/`;
const backLabel = d.parent ? d.parent.name : 'Overview';

// Peak over observed months only — between pulls the series is interpolated
// and its maximum is an artefact of when we looked.
const pk = observedPeak(S.cum_c);
const offPeak = pk.value ? total / pk.value - 1 : 0;
const shrinking = hasSeries && pk.index < last && offPeak < -0.005;
---

<Base
  title={`${d.full_name} — Alojamento Local`}
  active="areas"
  description={`${num0(total)} registered short-lets in ${d.full_name}, ${monthLabel(m.data_through)}.`}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={`${base}/`}>Portugal</a>
    {d.parent_path && <> › <span>{d.parent_path}</span></>}
    › <span aria-current="page">{d.name}</span>
  </nav>

  <h1>{d.full_name}</h1>
  <p class="lede">
    {
      shrinking ? (
        <>
          {num0(total)} registered short-lets, {pct1(Math.abs(offPeak))} fewer
          than at the last count before the decline ({num0(pk.value)} in{' '}
          {monthLabel(pk.month)}).
        </>
      ) : (
        <>{num0(total)} registered short-lets as of {monthLabel(m.data_through)}.</>
      )
    }
    {d.population != null && <> Population {num0(d.population)}.</>}
    {' '}<a href={backHref}>← {backLabel}</a>
  </p>

  {/* Three questions, three groups: how big it is, where it sits against
      everywhere else, and how unevenly it is spread inside itself. Ranks in
      particular only compare with each other, so they belong together. */}
  <div class="metric-groups" aria-label="Headline figures">
    <section class="metric-group" aria-labelledby="g-size">
      <h2 class="metric-group-title" id="g-size">Size</h2>
      <div class="grid">
        <Metric
          title="Registered short-lets"
          value={num0(total)}
          change={growth3y}
          changeLabel="over three years"
        />
        <Metric
          title="Inhabitants per short-let"
          value={inhabPerAl == null ? '—' : num0(inhabPerAl)}
          change={inhabChange}
          changeLabel="over three years"
          note="Lower means denser: fewer residents for each registered let."
        />
      </div>
    </section>

    <section class="metric-group" aria-labelledby="g-rank">
      <h2 class="metric-group-title" id="g-rank">Where it ranks</h2>
      {/* The tiles stay, empty, rather than the group disappearing. A reader
          looking for a rank should find the place where a rank would be and be
          told it does not exist, not find nothing and assume they missed it. */}
      {!hasSeries && (
        <p class="small faint rank-na">
          Not ranked: every rank here is computed inside the monthly series, and
          this area has none<AzoresNote />
        </p>
      )}
      <div class="grid">
        <Metric
          title="In Portugal"
          value={rankC == null ? '—' : `${num0(rankC)}`}
          context={`of ${num0(peers)} ${a.admin_type === 'region' ? 'districts' : a.admin_type === 'municipality' ? 'municipalities' : 'localities'}`}
          rank={rankC != null && rankCThen != null ? rankC - rankCThen : null}
          changeLabel="over three years"
        />
        {
          !isRegion && (
            <Metric
              title="In its district"
              value={rankR == null ? '—' : `${num0(rankR)}`}
              rank={rankR != null && rankRThen != null ? rankR - rankRThen : null}
              changeLabel="over three years"
            />
          )
        }
        {
          isLocality && (
            <Metric
              title="In its municipality"
              value={rankM == null ? '—' : `${num0(rankM)}`}
              rank={rankM != null && rankMThen != null ? rankM - rankMThen : null}
              changeLabel="over three years"
            />
          )
        }
      </div>
    </section>

    {
      !isLocality && d.skew && (
        <section class="metric-group" aria-labelledby="g-conc">
          <h2 class="metric-group-title" id="g-conc">How concentrated</h2>
          <div class="grid">
            <Metric
              title="Localities holding half its ALs"
              value={pct1(d.skew.locality_rank_pcnt)}
              note={`${d.skew.locality_rank} localities hold 50% of everything registered here`}
            />
            <Metric
              title="Population living there"
              value={pct1(d.skew.total_population_pcnt)}
              note="Share of this area's population in those same localities"
            />
          </div>
        </section>
      )
    }
  </div>

  {!hasSeries && (
    <>
      <h2>No history for this area</h2>
      <p>
        Everything above is this month's count. There is no chart on this page
        because there is nothing to plot it against — and that is a fact about
        the register, not a gap in this site.
      </p>
      <AzoresNote mode="note" />
    </>
  )}

  {hasSeries && (
  <>
  <h2>Registrations over time</h2>
  <figure>
    <TimeSeries
      client:load
      months={months}
      line={S.cum_c}
      bars={S.c}
      lineLabel="Total registered"
      barLabel="New that month"
      events={evs}
      height={300}
    />
    <figcaption>
      The line is the running total; bars are registrations added each month.
      The numbered dashed rules mark changes to the national law.
    </figcaption>
  </figure>
  <EventKey events={evs2} />

  <h2>Licences leaving the register</h2>
  <section class="grid" aria-label="Lost licences">
    <Metric
      title="Lost last month"
      value={num0(lost.lastMonth)}
      note={`${monthLabel(m.data_through)} alone`}
    />
    <Metric
      title="Lost year to date"
      value={num0(lost.ytd)}
      note={`Against ${num0(lost.prevYear)} in all of ${Number(m.data_through.slice(0, 4)) - 1}`}
    />
  </section>
  {
    (S.cum_lost[last] ?? 0) > 0 ? (
      <figure>
        <TimeSeries
          client:visible
          months={months}
          line={S.cum_lost}
          bars={S.lost}
          lineLabel="Lost, cumulative"
          barLabel="Lost that month"
          events={evs}
          height={260}
          startIndex={lossStartIndex()}
          unobserved={unobservedIndices()}
        />
        <figcaption>
          Losses are only visible between two pulls of the register, so this
          starts at {monthLabel(m.loss_observable_from)}. The gap with no pull is
          left blank rather than drawn as zero.
        </figcaption>
      </figure>
    ) : (
      <p class="muted small">
        No registration here has been seen to leave the register since
        {monthLabel(m.loss_observable_from)}, which is as far back as losses
        can be detected.
      </p>
    )
  }

  <h2>Growth, against a month you choose</h2>
  <p>
    Every line starts at 100% in the base month, so they compare regardless of
    size. Drag the slider to move the base.
  </p>
  <figure>
    <GrowthExplorer
      client:visible
      months={months}
      hierarchy={d.hierarchy}
      subareas={d.subareas}
      events={evs}
      height={330}
    />
  </figure>
  <EventKey events={evs2} title="The same marks, on this chart" />

  </>
  )}

  {
    hasSeries && !isLocality && d.subareas.length > 0 && (
      <>
        <h2>How the total splits</h2>
        <figure>
          <SubareaMix client:visible months={months} subareas={d.subareas} height={320} />
          <figcaption>
            Absolute totals show growth; the share view shows which subareas
            gained ground, which growth alone hides.
          </figcaption>
        </figure>
      </>
    )
  }

  {
    isRegion && kids.length > 0 && locs.length > 0 && (
      <Tabs
        id="lists"
        label="Areas within this district"
        tabs={[
          { id: 'municipalities', label: `Municipalities (${kids.length})` },
          { id: 'localities', label: `Localities (${locs.length})` },
        ]}
      >
        <Fragment slot="municipalities">
          <AreaTable client:visible rows={kids.map(toRow)} base={base} caption={`${kids.length} municipalities`} />
        </Fragment>
        <Fragment slot="localities">
          <AreaTable client:visible rows={locs.map(toRow)} base={base} caption={`Every locality in ${d.name} — ${locs.length}`} />
        </Fragment>
      </Tabs>
    )
  }
  {
    isRegion && kids.length > 0 && locs.length === 0 && (
      <>
        <h2>Municipalities</h2>
        <AreaTable client:visible rows={kids.map(toRow)} base={base} caption={`${kids.length} municipalities`} />
      </>
    )
  }
  {
    !isRegion && !isLocality && kids.length > 0 && (
      <>
        <h2>Localities</h2>
        <AreaTable client:visible rows={kids.map(toRow)} base={base} caption={`${kids.length} localities`} />
      </>
    )
  }

  {
    d.rooms.length > 0 && (
      <>
        <h2>What size are they?</h2>
        <RoomMix
          rows={d.rooms}
          caption={`Room mix in ${d.name}, against the levels above it.`}
        />
      </>
    )
  }
</Base>
