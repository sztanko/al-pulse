---
/** The key to the drawn map's colours.
 *
 * Server-rendered, so it costs nothing and is there whether or not the canvas
 * ever draws. It says what the ramp means and nothing else: the numbers behind
 * it are in the table on the same page, and repeating them here would be two
 * sources for one fact.
 */
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** What the coloured shapes are, e.g. "municipalities". */
  what: string;
}

const { lang, what } = Astro.props;
---

<p class="aart-key">
  <span>{t(lang, 'art.key_low')}</span>
  <i aria-hidden="true">
    {[1, 2, 3, 4, 5, 6, 7].map((n) => <span style={`background: var(--m-div-${n})`} />)}
  </i>
  <span>{t(lang, 'art.key_high', { what })}</span>
</p>
