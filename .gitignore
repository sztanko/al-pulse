
target/
dbt_packages/
logs/
.venv
node_modules/
downloads/al/*.csv
# The untouched Azorean pull, kept for provenance and for --from-raw. It
# still holds the operator's name, e-mail and phone number; only the
# cleansed CSV beside it is committed.
downloads/azores/raw/
downloads/osm/admin.geojson
data/prod.duckdb
# DuckDB's spill directory and WAL, created by the PRAGMA in
# dbt_project.yml. Build scratch, never source.
data/duckdb_tmp/
data/*.wal
__pycache__
*.osm.pbf
.DS_Store
*.dbf
*.prj
*.shp
*.shx
*.geojson
*.parquet

# --- bespoke site ---
# site/data is generated by scripts/export_site_data.py from the DuckDB marts:
# build input, not source. Regenerate with ./scripts/run_report.sh.
site/data/
site/dist/
site/.astro/
# Simplified locality geometry, generated by scripts/export_to_geojson.sh.
site/public/geo/

# The address file the geocoder reads (~600 MB). Fetched on first use; only
# its output, downloads/geocode/al_geocoded.csv.gz, is committed.
data/bnm/

# The Madeira map (scripts/build_madeira_map.py) is generated, never committed:
# run_report.sh builds it into site/public/madeira-map on every deploy.
data/madeira_map/
site/public/madeira-map/
